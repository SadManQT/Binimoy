# Placeholders only. Copy to .env and fill in. Never commit a real .env.
APP_ENV=local

# PostgreSQL connection string.
# Supabase: Project Settings > Database > Connection string. Use the DIRECT
# connection or the SESSION pooler (port 5432). The transaction pooler (6543)
# does not keep the session lock that the schema setup relies on.
# Optional local Docker instead: run `pnpm db:local` and use
#   postgres://lp:lp_local_only@localhost:54329/lp
DATABASE_URL=

# Public origin of the web app, no trailing slash.
APP_URL=http://localhost:3000
# Signs session cookies. At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=

# Social sign-in. A provider appears on the login page only when both of its
# values are set. Redirect URI to register: <APP_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret vault (spec D.7). Leave all four empty to run without the vault.
# For local use, `pnpm matrix:local` starts a homeserver in Docker and fills
# these in for you.
MATRIX_HOMESERVER_URL=
MATRIX_SERVER_NAME=
MATRIX_JWT_SECRET=
MATRIX_REGISTRATION_SECRET=

# Integration tests run in their own `lp_test` schema of DATABASE_URL.
# Set this only to send them to a different database.
TEST_DATABASE_URL=

PAYMENT_MODE=mock
VERIFIER_MODE=mock
RESEARCH_MODE=fixture
AI_MODE=fixture
# Required only when the matching mode is "live":
SEARCH_API_KEY=
MODEL_API_KEY=
